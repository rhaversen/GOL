{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/O2",
                "/Oi",
                "/GL",
                "/EHsc",
                "/nologo",
                "/DNDEBUG",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\build\\GameOfLife.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\BitGrid.cpp",
                "${workspaceFolder}\\src\\CanonicalState.cpp",
                "${workspaceFolder}\\src\\SpiralGenerator.cpp",
                "${workspaceFolder}\\src\\LifeRunner.cpp",
                "${workspaceFolder}\\src\\StateCache.cpp",
                "${workspaceFolder}\\src\\CachedLifeAnalyzer.cpp",
                "/link",
                "/LTCG"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}